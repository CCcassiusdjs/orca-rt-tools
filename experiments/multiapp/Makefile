# Several applications on one NoC (rttools.multiapp): CAR-V (16 PEs) and
# application E (4 PEs) on the 4x5 mesh, each one on its own PEs, sharing
# routers and links. The flow builds one link schedule for the union of the
# packets of both applications and one clock for the platform.
#
#   make           run + check + maps-check + app-check + analyze + check-run of the stored
#                  run MA + check-tma + check-uma (default; about 1 min)
#   make run       analysis flow on composition.json (f_CPU per application, f_NoC of the union,
#                  frequency of the platform, R_bound per application, shared links, collisions of
#                  the schedules of each application alone), the other order (composition-e-first.json),
#                  1,000 random placements and each application alone against the flow of one
#                  application; outputs in $(BUILD)
#   make check     compare $(BUILD)/metrics.json with reference.json
#   make maps      write maps/CARV.map and maps/E.map from the placement of composition.json
#   make maps-check  the stored maps equal the placement
#   make app       write pkt-sim/software/ucx-os/app/$(NAME).{c,json,sim} (rttools.ucxgen compose) and
#                  $(NAME)_tt.h (rttools.ucxgen tt-compose at F_CLK: injection instants of the
#                  time-triggered injection)
#   make app-check the stored $(NAME).{c,json,sim} and $(NAME)_tt.h match a new composition (and
#                  e_ucx.{c,json,sim} and e_ucx_tt.h a new generation); heap demand of each
#                  PE (rttools.ucxgen.memory) against HEAP
#   make build     build $(NAME) in $(BUILD)/pkt-sim (riscv64-elf toolchain); heap demand against
#                  _heap_size of the image
#   make sim       RTL simulation (Questa and riscv64-elf; ENV_SETUP as in exp23) at F_CLK:
#                  F_CLK=$(F_CLK) ../exp23/simulate.sh $(BUILD)/sim $(SIM_NS) $(NAME)
#                  (mesh 4x5 and RELEASE_MASK from app/$(NAME).sim)
#   make analyze   analysis of $(LOG) for each application (rttools.paper.rtlapp --app, link
#                  schedule of the union with --composition) into $(OUTDIR)/CARV and $(OUTDIR)/E
#   make check-run compare $(OUTDIR)/<app>/metrics.json with reference_$(RUN_ID)_<app>.json
#   make phase-check  conformance of $(OUTDIR)/<app>/metrics.json with the phase model
#                  (rttools.paper.phasecheck; exit 1 otherwise)
#   make check-tma analyze + check-run + phase-check of the stored run TMA (logs/TMA.*: carv_e of
#                  tag r11-rc3, release by tick on the 20 PEs, kernel without nested interrupts,
#                  434.912 MHz, 11.5 ms) against reference_TMA_CARV.json and reference_TMA_E.json,
#                  into $(BUILD)/results_TMA
#   make check-uma the same for the stored run UMA (logs/UMA.*: carv_e of tag r11-rc5, as TMA with the
#                  crt0.s with the return test of _isr and the read back of _interrupt_set(0),
#                  crt0=guard_readback) against reference_UMA_CARV.json and reference_UMA_E.json,
#                  into $(BUILD)/results_UMA
#   make sim-e     control run: application E alone, generated by rttools.ucxgen (app/e_ucx.*,
#                  2x2, the .map of apps/synthetic-app-e) at F_CLK for SIM_NS, in $(BUILD)/sim-e;
#                  make analyze-e analyzes it into $(BUILD)/results_e (separates the effect of
#                  the generator on E from the effect of the composition)
#   make diag      diagnostic run of PE $(DIAG_X)-$(DIAG_Y) (default 0-1, task BFE3 of CAR-V): the
#                  simulation of run MA (carv_e, F_CLK, vsim -voptargs=+acc) stops at 6.3 ms;
#                  diag_pe.do writes $(BUILD)/diag/out/diag.txt (PC, pipeline and interrupt
#                  signals per cycle in 1,800-cycle windows from 5,699,500 ns and 6,199,500 ns,
#                  registers and 400 cycles at 6,210,000 ns and 6,300,000 ns) and the memory of
#                  the PE at both instants (pe0-1.<t>ns.mem); about 11 min of vsim
#   make diag-check  events of the diagnostic run up to 6,300,000 ns against logs/MA.events.txt
#                  (same simulation); bash, awk and cmp only
# sim, sim-e, diag and diag-check use no Python (simulate.sh: bash, make,
# Questa and riscv64-elf).
#
# Release rule (RELEASE, --release of rtlapp): carv_e.c and e_ucx.c of this tree have the
# release by tick (app/carv_e.sim and app/e_ucx.sim: TICK_RELEASE=1, RELEASE_MASK of all PEs);
# run MA is of the data-driven release (carv_e.c of r11-multiapp-rc1 = `rttools.ucxgen compose
# --release data`). auto (default) reads the line `release` of the RUN_INFO; a RUN_INFO without
# it (run MA) gives data.
#
# LOG, OUTDIR and RUN_ID default to the stored run MA (logs/MA.*: tag
# r11-multiapp-rc1, 434.912 MHz, 11.5 ms; reference_MA_CARV.json,
# reference_MA_E.json). In run MA, task BFE3 of CAR-V (PE 4, 0-1) stops
# after iteration 6 and PE 4 halts at 8.2 ms (heap exhausted by the queued
# packets, logs/MA.output-0-1.txt): the responses of CAR-V cover
# iterations 1 to 6 (PR-403-multiapp-noc.md).
#
# F_CLK: the clock of the platform from the flow with the model of the
# time-triggered injection and t(v) = max(CSV, static) (experiments/tt, run
# VMA): f_CPU 443.346 MHz on the grid of 32 kHz, 443.36 MHz (the runs MA,
# TMA and UMA ran at 434.912 MHz, f_CPU of E with the costs of the CSV,
# metrics.json rtl.clock). SIM_NS: 3 ms + (n(v_last) of CAR-V = 4 + 8 measured
# iterations - 1) T + R_bound of CAR-V (2.218 ms) + T = 11.22 ms (metrics.json
# rtl.sim_ns_min), rounded up to 11.5 ms, the duration of the CAR-V runs.
# After `make sim`: make analyze LOG=$(BUILD)/sim/events.txt OUTDIR=$(BUILD)/results_sim.

PYTHON  ?= python3
RTTOOLS := $(abspath ../../orca-rt-tools)
APP_DIR := ../../pkt-sim/software/ucx-os/app
BUILD   ?= build
NAME    ?= carv_e
MESH    ?= 4x5
ARCH    := ../../arch/hermes-4x5.gml
CARV_CSV := ../../apps/car-v/car-v.csv
E_CSV   := ../../apps/synthetic-app-e/synthetic-app-e.csv
E_MAP2  := ../../apps/synthetic-app-e/synthetic-app-e-ONTO-hermes2x2.map
APPS     = --app CARV:$(CARV_CSV):maps/CARV.map --app E:$(E_CSV):maps/E.map
F_CLK   ?= 443360000
SIM_NS  ?= 11500000
# clocks of the injection tables carv_e_tt.h and e_ucx_tt.h: F_CLK and 500 MHz, the default clock of
# a build (arch.mak)
TT_CLOCKS ?= $(F_CLK) 500000000
# t(v) = max(CSV, static t(v) of the image of carv_e, experiments/wcet costs/tt) in the link schedule of
# carv_e_tt.h (e_ucx, no run of round r11f: the costs of the CSV)
TT_COSTS ?= ../wcet/costs/tt/carv_e.json
# _heap_size of the image of carv_e built with riscv64-unknown-elf-gcc 13.2,
# release by tick (TR_DEFS), crt0.s of this tree, time-triggered injection
# (INJECTION=tt; 48756 with INJECTION=finish, 48836 for the image of run TMA,
# crt0 plain; 49924 for the image of run MA; 47200 for the image of
# riscv64-elf-gcc 12.2.0); make build reads the value of the toolchain in use
HEAP    ?= 47232
# received packets in flight per input edge between PEs in the heap model
# (rttools/ucxgen/memory.py). With 2 (the value of experiments/car-v-rtl),
# PE 9 (G and J of application E: inputs F->G, H->J, I->J, 21,370 bytes of
# payload) needs 50,808 bytes, 900 bytes above the usable heap of the image;
# application E alone in the image of weird_a.c needs the same 50,808 bytes
# against 50,716 usable bytes, and runs F, G and H printed no "out of
# memory". With 1, the worst PE is 13 (36,224 bytes). The run checks the
# allocations: grep "out of memory" in pkt-sim/logs/output-*.txt.
IN_FLIGHT ?= 1
# network-interface model of the link schedule (RTTOOLS_NI,
# orca-rt-tools/rttools/modules/routing/router.py): off, the model of the
# stored references (runs up to tag r11-rc5); the default of rttools (tt)
# is the model of experiments/tt
NI      ?= off
RUN      = RTTOOLS_NI=$(NI) PYTHONPATH=$(RTTOOLS) $(PYTHON) -m rttools.paper.multiapp
GEN      = PYTHONPATH=$(RTTOOLS) $(PYTHON) -m rttools.ucxgen
ANALYZE  = PYTHONPATH=$(RTTOOLS) $(PYTHON) -m rttools.paper.rtlapp
CHECK    = PYTHONPATH=$(RTTOOLS) $(PYTHON) -m rttools.paper.exp23 check
LOG     ?= logs/MA.events.txt
OUTDIR  ?= $(BUILD)/results_MA
RUN_ID  ?= MA
RELEASE ?= auto

.PHONY: all run check maps maps-check app app-check build sim analyze check-run phase-check check-tma check-uma app-e sim-e analyze-e diag diag-check clean

all: run check maps-check app-check analyze check-run check-tma check-uma

run:
	$(RUN) run --config config.json --out $(BUILD)

check:
	$(CHECK) $(BUILD)/metrics.json reference.json

maps:
	$(RUN) maps --config config.json

maps-check:
	$(RUN) maps --config config.json --check

app:
	$(GEN) compose $(APPS) --name $(NAME) --mesh $(MESH) --out $(APP_DIR)
	$(GEN) tt-compose --composition composition.json --name $(NAME) $(foreach f,$(TT_CLOCKS),--clock $(f)) --costs $(TT_COSTS) --out $(APP_DIR)

app-check:
	$(GEN) compose-check $(APPS) --name $(NAME) --mesh $(MESH) --out $(APP_DIR)
	$(GEN) check $(E_CSV) $(E_MAP2) --name e_ucx --mesh 2x2 --out $(APP_DIR)
	$(GEN) tt-compose-check --composition composition.json --name $(NAME) $(foreach f,$(TT_CLOCKS),--clock $(f)) --costs $(TT_COSTS) --out $(APP_DIR)
	$(GEN) tt-check $(E_CSV) $(E_MAP2) --arch ../../arch/hermes-2x2.gml --name e_ucx $(foreach f,$(TT_CLOCKS),--clock $(f)) --out $(APP_DIR)
	$(GEN) memory $(APP_DIR)/$(NAME).json --heap $(HEAP) --in-flight $(IN_FLIGHT)

build:
	rm -rf $(BUILD)/pkt-sim
	mkdir -p $(BUILD)
	cp -a ../../pkt-sim $(BUILD)/pkt-sim
	cd $(BUILD)/pkt-sim/software/ucx-os && $(MAKE) -s ARCH=riscv/hf-riscv-e incl && $(MAKE) -s $(NAME)
	$(GEN) memory $(APP_DIR)/$(NAME).json --image-map $(BUILD)/pkt-sim/software/ucx-os/build/target/image.map \
		--in-flight $(IN_FLIGHT) --json $(BUILD)/memory.json

sim:
	F_CLK=$(F_CLK) ../exp23/simulate.sh $(BUILD)/sim $(SIM_NS) $(NAME)

analyze:
	$(ANALYZE) analyze $(LOG) --manifest $(APP_DIR)/$(NAME).json --app CARV --csv $(CARV_CSV) \
		--map maps/CARV.map --arch $(ARCH) --composition composition.json --out $(OUTDIR)/CARV --release $(RELEASE)
	$(ANALYZE) analyze $(LOG) --manifest $(APP_DIR)/$(NAME).json --app E --csv $(E_CSV) \
		--map maps/E.map --arch $(ARCH) --composition composition.json --out $(OUTDIR)/E --release $(RELEASE)

check-run:
	$(CHECK) $(OUTDIR)/CARV/metrics.json reference_$(RUN_ID)_CARV.json
	$(CHECK) $(OUTDIR)/E/metrics.json reference_$(RUN_ID)_E.json

phase-check:
	PYTHONPATH=$(RTTOOLS) $(PYTHON) -m rttools.paper.phasecheck $(OUTDIR)/CARV/metrics.json \
		$(OUTDIR)/E/metrics.json --rows 5

check-tma:
	$(MAKE) analyze check-run phase-check LOG=logs/TMA.events.txt OUTDIR=$(BUILD)/results_TMA RUN_ID=TMA

check-uma:
	$(MAKE) analyze check-run phase-check LOG=logs/UMA.events.txt OUTDIR=$(BUILD)/results_UMA RUN_ID=UMA

app-e:
	$(GEN) generate $(E_CSV) $(E_MAP2) --name e_ucx --mesh 2x2 --out $(APP_DIR)
	$(GEN) tt $(E_CSV) $(E_MAP2) --arch ../../arch/hermes-2x2.gml --name e_ucx $(foreach f,$(TT_CLOCKS),--clock $(f)) --out $(APP_DIR)

sim-e:
	F_CLK=$(F_CLK) ../exp23/simulate.sh $(BUILD)/sim-e $(SIM_NS) e_ucx

analyze-e:
	$(ANALYZE) analyze $(BUILD)/sim-e/events.txt --manifest $(APP_DIR)/e_ucx.json --csv $(E_CSV) \
		--map $(E_MAP2) --arch ../../arch/hermes-2x2.gml --out $(BUILD)/results_e

DIAG_X  ?= 0
DIAG_Y  ?= 1
DIAG_NS ?= 6400000
DIAG_UNTIL_NS ?= 6300000

diag:
	DIAG_DIR=$(abspath $(BUILD)/diag/out) DIAG_X=$(DIAG_X) DIAG_Y=$(DIAG_Y) RUN_DO=$(abspath diag_pe.do) \
		VSIM_OPTS=-voptargs=+acc F_CLK=$(F_CLK) ../exp23/simulate.sh $(BUILD)/diag $(DIAG_NS) $(NAME)

diag-check:
	awk '$$1 == "#" && $$2 ~ /^[0-9]+$$/ && $$2 < $(DIAG_UNTIL_NS)' logs/MA.events.txt > $(BUILD)/diag/ma.until
	awk '$$1 == "#" && $$2 ~ /^[0-9]+$$/ && $$2 < $(DIAG_UNTIL_NS)' $(BUILD)/diag/events.txt > $(BUILD)/diag/diag.until
	cmp $(BUILD)/diag/ma.until $(BUILD)/diag/diag.until && \
		echo "diag: $$(wc -l < $(BUILD)/diag/diag.until) event lines up to $(DIAG_UNTIL_NS) ns equal to run MA"

clean:
	rm -rf $(BUILD)

# CAR-V (vision subgraph of CAR at the time scale of application E) on the
# 4x4 manycore: UCX-OS application generated by rttools.ucxgen and its RTL
# simulation.
#
#   make app     write pkt-sim/software/ucx-os/app/$(NAME).{c,json,sim} from $(CSV) and $(MAP)
#   make check   the stored $(NAME).{c,json,sim} match a new generation; heap demand of
#                each PE (rttools.ucxgen.memory) against HEAP (default target)
#   make build   build $(NAME) in build/pkt-sim (riscv64-elf toolchain); heap demand
#                against _heap_size of the image
#   make sim     RTL simulation (Questa and riscv64-elf; ENV_SETUP as in exp23) at F_CLK:
#                F_CLK=$(F_CLK) ../exp23/simulate.sh build/sim $(SIM_NS) $(NAME) $(MESH)
#   make flow-clock  F_CLK of a run at the minimum frequency of the CAR-V flow (make -C ../car-v run,
#                chosen candidate): the first multiple of 32 kHz at or above it (exp23.flow_clock)
#   make sim-flow  sim at that F_CLK in build/sim-flow
#
# CSV and MAP: the files of the CAR-V analysis flow (apps/car-v, rttools.paper.carv)
# when they exist, otherwise input/car-v.csv and input/car-v.map, provisional
# (subgraph "vscaled" of the r9 analysis: T = 0.5 ms, cost x 8 + 11,000 cycles,
# payload / 16). When the source changes, `make check` fails until `make app`
# writes the three files again (commit them).
# SIM_NS: release delay 3 ms + (n(OBMG) = 4 warm-up iterations + 8 measured
# iterations - 1) x 0.5 ms + R_bound 2.25 ms + one tick (0.5 ms) of release
# offset = 11.25 ms, rounded up to 11.5 ms (PR-110-car-v-rtl.md).

PYTHON  ?= python3
RTTOOLS := $(abspath ../../orca-rt-tools)
APP_DIR := ../../pkt-sim/software/ucx-os/app
NAME    ?= car_v
CSV     ?= $(firstword $(wildcard ../../apps/car-v/car-v.csv) input/car-v.csv)
MAP     ?= $(firstword $(wildcard ../../apps/car-v/car-v-ONTO-hermes4x4.map) input/car-v.map)
MESH    ?= 4x4
GENFLAGS ?=
BUILD   ?= build
SIM_NS  ?= 11500000
# clock of the simulation (Hz); default 500 MHz, the clock of run F
F_CLK   ?= 500000000
CARV_METRICS ?= ../car-v/build/metrics.json
FLOW_F_CLK = $(PYTHON) -c "import json; from rttools.paper import exp23; \
	m = json.load(open('$(CARV_METRICS)')); \
	print(exp23.flow_clock(m['chosen']['search']['frequency_hz'], m['scale']['period_s'])['f_clk_hz'])"
# _heap_size of the image of car_v built with riscv64-unknown-elf-gcc 13.2
# (make build reads the value of the toolchain in use)
HEAP    ?= 50676
IN_FLIGHT ?= 2
GEN      = PYTHONPATH=$(RTTOOLS) $(PYTHON) -m rttools.ucxgen

.PHONY: all app check build sim flow-clock sim-flow clean

all: check

app:
	$(GEN) generate $(CSV) $(MAP) --name $(NAME) --mesh $(MESH) --out $(APP_DIR) $(GENFLAGS)

check:
	$(GEN) check $(CSV) $(MAP) --name $(NAME) --mesh $(MESH) --out $(APP_DIR) $(GENFLAGS)
	$(GEN) memory $(APP_DIR)/$(NAME).json --heap $(HEAP) --in-flight $(IN_FLIGHT)

build:
	rm -rf $(BUILD)/pkt-sim
	mkdir -p $(BUILD)
	cp -a ../../pkt-sim $(BUILD)/pkt-sim
	cd $(BUILD)/pkt-sim/software/ucx-os && $(MAKE) -s ARCH=riscv/hf-riscv-e incl && $(MAKE) -s $(NAME)
	$(GEN) memory $(APP_DIR)/$(NAME).json --image-map $(BUILD)/pkt-sim/software/ucx-os/build/target/image.map \
		--in-flight $(IN_FLIGHT) --json $(BUILD)/memory.json

sim:
	F_CLK=$(F_CLK) ../exp23/simulate.sh $(BUILD)/sim $(SIM_NS) $(NAME) $(MESH)

flow-clock:
	$(MAKE) -C ../car-v run PYTHON=$(PYTHON)
	PYTHONPATH=$(RTTOOLS) $(FLOW_F_CLK)

sim-flow:
	$(MAKE) -C ../car-v run PYTHON=$(PYTHON)
	F_CLK=$$(PYTHONPATH=$(RTTOOLS) $(FLOW_F_CLK)) ../exp23/simulate.sh $(BUILD)/sim-flow $(SIM_NS) $(NAME) $(MESH)

clean:
	rm -rf $(BUILD)

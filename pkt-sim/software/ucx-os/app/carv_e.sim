# Setup of manycore_top for app/carv_e.c (rttools.ucxgen); read by
# experiments/exp23/simulate.sh. RELEASE_MASK: bit k = PE with node index k
# (PEs 1, 2, 3, 7, 8, 11, 12, 14, 16). Release period 500000 ns, first release at 3000000 ns: the
# defaults of the release generator (manycore_pe.sv).
MESH=4x5
RELEASE_MASK=88462
